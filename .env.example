# 复制为 .env 后按需修改。所有变量都可以改用同名环境变量覆盖（环境变量优先）。
SA_HOST=127.0.0.1
SA_PORT=8000
SA_LOG_LEVEL=info
# 第 05 章起用于远程调用鉴权；留空表示未启用
SA_API_TOKEN=

# ---- 第 02 章：LLM（任一 OpenAI 兼容接口，需支持 tool calling）----
# 模型名与地址以厂商控制台为准（2026-09 核实：DeepSeek 旧名 deepseek-chat 已于 2026-07-24 下线）
# LLM_PROVIDER=mock            # 设为 mock 则不调用真实模型
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
# 厂商私有参数（JSON，合并进请求体）。DeepSeek V4 默认开启思考，排障场景建议关闭以降低延迟：
LLM_EXTRA_BODY={"thinking": {"type": "disabled"}}
# 通义千问（百炼）示例：
#   LLM_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
#   LLM_EXTRA_BODY={"enable_thinking": false}
# 本地 vLLM：LLM_BASE_URL=http://127.0.0.1:8000/v1   Ollama：LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_TEMPERATURE=0.2
# LLM_TIMEOUT=60
# LLM_MAX_RETRIES=2
# LLM_STREAM_USAGE=true
